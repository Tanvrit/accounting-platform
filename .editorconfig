root = true

[*.{kt,kts}]
# ktlint engine 1.5.0, Kotlin official code style.
ktlint_code_style = ktlint_official
indent_size = 4
max_line_length = 140
# Compose convention: composables returning Unit are named LikeClasses.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Compose resource generation + build output are not lintable.
[**/build/**]
ktlint = disabled
